# ─── Build output (regenerated by scripts/build-deb.sh; ~3 GB) ─────────────
#  The .deb packages and the full extracted Electron runtime they are built
#  from. Never commit — anyone can rebuild with: ./scripts/build-deb.sh <ver>
poc/packages/
# electron-builder --dir output (linux-unpacked; regenerated by scripts/build-version.sh)
poc/dist-electron/

# ─── Node.js dependencies (run: npm install in poc/electron-app/) ──────────
poc/electron-app/node_modules/

# ─── GPG secrets & generated repository state ──────────────────────────────
#  ⚠️  NEVER commit gpg-home/ — it contains the PRIVATE signing key.
#  setup-repo.sh idempotently generates the byclaw-poc key pair (kept in
#  gpg-home/); the exported public key + aptly.conf are regenerated per run
#  (aptly.conf is generated from aptly.conf.tmpl with the clone's absolute
#  rootDir — spec §14.2/§14.4; never commit the generated file).
poc/apt-repository/gpg-home/
poc/apt-repository/aptly.conf
poc/apt-repository/byclaw-poc-public.gpg
poc/apt-repository/nanobot-poc-public.gpg
poc/apt-repository/.server.pid
# aptly database + published repo + update-policy.json build artifact (regenerated
# by setup-repo.sh / publish-byclaw.sh / build-version.sh)
poc/apt-repository/aptly-db/

# ─── Runtime logs & test output (regenerated) ───────────────────────────────
poc/logs/
poc/tests/results/

# ─── Validation evidence v2 (regenerated by tests-v2/run-all-cases.sh) ──────
#  Verdicts, screenshots, build/ps/grep logs are local run output — never
#  commit (anyone can regenerate: bash poc/tests-v2/run-all-cases.sh).
poc/evidence-v2/*
!poc/evidence-v2/.gitkeep

# ─── Editor / OS cruft ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
