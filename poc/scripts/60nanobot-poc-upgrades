// Nanobot POC: Unattended-upgrades configuration
// Only auto-upgrade nanobot packages from the POC repository.

Unattended-Upgrade::Allowed-Origins {
    "Lenovo:noble";
};

// Whitelist: packages that SHOULD be auto-upgraded
Unattended-Upgrade::Package-Whitelist {
    "^nanobot$";
    "^nanobot-.*";
};

// Blacklist: explicitly block all non-nanobot POC packages
Unattended-Upgrade::Package-Blacklist {
    "unrelated-poc";
    "random-test-poc";
};

Unattended-Upgrade::AutoFixInterruptedDpkg "true";
Unattended-Upgrade::MinimalSteps "true";
